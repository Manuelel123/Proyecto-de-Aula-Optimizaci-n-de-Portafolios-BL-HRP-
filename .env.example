# Copy to .env and fill in.
# Long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))".
# Without it sessions end on every restart (the app logs a warning).
FLASK_SECRET_KEY=
# Gmail SMTP for verification and password-reset codes (app password, not
# the normal one: Google account > Security > 2-Step Verification > App passwords).
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=
# Or Brevo's HTTPS API instead of SMTP (needed on Render's free plan). With it,
# MAIL_FROM is required: a sender verified in Brevo, e.g. Atlas <you@gmail.com>.
# BREVO_API_KEY=
# Optional server-side price cache in InsForge (accounts are local):
#   INSFORGE_URL     -> "oss_host" in .insforge/project.json
#   INSFORGE_API_KEY -> "api_key" in .insforge/project.json (server only, admin key)
INSFORGE_URL=
INSFORGE_API_KEY=
# Optional
# TIINGO_API_KEY=
# ATLAS_PRICE_FULL_REFRESH_DAYS=7
# ATLAS_PRICE_INTRADAY_TTL_MINUTES=60
# Local database: users, backtest history and tracked portfolios
# (default sqlite:///instance/atlas.db)
# DATABASE_URL=
# Behind a reverse proxy (Render: 1): trusted hops for the client IP and HTTPS.
# Leave unset when the app is reached directly.
# ATLAS_PROXY_HOPS=
