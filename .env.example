# Copy to .env and fill in.
# Long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))".
# Without it sessions end on every restart (the app logs a warning).
FLASK_SECRET_KEY=
# Optional server-side price cache in InsForge (accounts are local):
#   INSFORGE_URL     -> "oss_host" in .insforge/project.json
#   INSFORGE_API_KEY -> "api_key" in .insforge/project.json (server only, admin key)
INSFORGE_URL=
INSFORGE_API_KEY=
# Optional
# TIINGO_API_KEY=
# ATLAS_PRICE_FULL_REFRESH_DAYS=7
# ATLAS_PRICE_INTRADAY_TTL_MINUTES=60
# Local database: users, backtest history and tracked portfolios
# (default sqlite:///instance/atlas.db)
# DATABASE_URL=
