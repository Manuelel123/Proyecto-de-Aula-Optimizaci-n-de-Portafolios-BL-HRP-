# Copy to .env and fill in. Values for the linked project:
#   INSFORGE_URL      -> "oss_host" in .insforge/project.json
#   INSFORGE_ANON_KEY -> npx -y @insforge/cli secrets get ANON_KEY
#   INSFORGE_API_KEY  -> "api_key" in .insforge/project.json (server only)
FLASK_SECRET_KEY=
INSFORGE_URL=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=
# Optional
# TIINGO_API_KEY=
# ATLAS_PRICE_DB_TTL_HOURS=24
